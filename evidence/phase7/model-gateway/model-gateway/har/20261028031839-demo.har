{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "test-agent",
      "version": "0.1.0"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "https://production.example.test/api/health?verbose=true",
          "headers": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "[REDACTED]"
            }
          ],
          "queryString": [
            {
              "name": "verbose",
              "value": "true"
            }
          ]
        }
      },
      {
        "request": {
          "method": "POST",
          "url": "https://production.example.test/api/echo",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ],
          "queryString": [],
          "postData": {
            "mimeType": "application/json",
            "text": "{\"password\":\"[REDACTED]\",\"message\":\"hello\"}"
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "url": "https://production.example.test/api/fail",
          "headers": [],
          "queryString": []
        }
      }
    ]
  }
}
