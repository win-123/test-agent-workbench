{
  "schema_version": "test-agent.ui-case/v1",
  "case_id": "ui-order-failure-diagnostic",
  "name": "Intentional failing diagnostic for screenshot evidence",
  "version": 1,
  "target_url": "http://127.0.0.1:8090/",
  "allowed_origins": ["http://127.0.0.1:8090"],
  "timeout_ms": 3000,
  "headless": true,
  "steps": [
    {
      "id": "open",
      "action": "navigate",
      "url": "http://127.0.0.1:8090/"
    },
    {
      "id": "username",
      "action": "fill",
      "locator": { "kind": "label", "value": "Username" },
      "value": "demo"
    },
    {
      "id": "password",
      "action": "fill",
      "locator": { "kind": "label", "value": "Password" },
      "value": "demo123"
    },
    {
      "id": "login",
      "action": "click",
      "locator": { "kind": "role", "role": "button", "name": "Open workspace", "value": "Open workspace" }
    },
    {
      "id": "customer",
      "action": "fill",
      "locator": { "kind": "label", "value": "Customer" },
      "value": "Acme QA"
    },
    {
      "id": "simulate-failure",
      "action": "click",
      "locator": { "kind": "label", "value": "Simulate downstream failure" }
    },
    {
      "id": "submit",
      "action": "click",
      "locator": { "kind": "role", "role": "button", "name": "Create order", "value": "Create order" }
    },
    {
      "id": "wrong-expectation",
      "action": "assert",
      "assertion": "containsText",
      "locator": { "kind": "testId", "value": "order-result" },
      "expected": "Order created"
    }
  ],
  "created_at": "2026-10-28T00:00:00.000Z",
  "updated_at": "2026-10-28T00:00:00.000Z"
}
